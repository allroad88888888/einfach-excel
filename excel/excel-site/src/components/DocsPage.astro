---
import SiteLayout from '../layouts/SiteLayout.astro'

interface Props {
  title: string
  eyebrow: string
  summary: string
  locale?: 'en' | 'zh'
  alternateLocaleHref?: string
}

const { title, eyebrow, summary, locale = 'en', alternateLocaleHref } = Astro.props
---

<SiteLayout locale={locale} title={title + ' · einfach excel'} alternateLocaleHref={alternateLocaleHref}>
  <main class="page docs-page">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-intro">{summary}</p>
    <article class="demo-narrative">
      <slot />
    </article>
  </main>
</SiteLayout>
