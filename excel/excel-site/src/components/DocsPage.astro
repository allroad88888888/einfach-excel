---
import SiteLayout from '../layouts/SiteLayout.astro'
import '../styles/docs-guide.css'

interface Props {
  title: string
  eyebrow: string
  summary: string
  locale?: 'en' | 'zh'
  alternateLocaleHref?: string
}

const { title, eyebrow, summary, locale = 'en', alternateLocaleHref } = Astro.props
---

<SiteLayout locale={locale} title={title + ' · einfach excel'} alternateLocaleHref={alternateLocaleHref}>
  <main class="product-page product-docs-page">
    <header class="product-intro">
      <p class="product-eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{summary}</p>
    </header>
    <article class="product-narrative">
      <slot />
    </article>
  </main>
</SiteLayout>
