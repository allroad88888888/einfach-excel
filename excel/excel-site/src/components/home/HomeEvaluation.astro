---
import type { HomeContent } from '../../data/home-content'

interface Props {
  content: HomeContent['evaluation']
  links: Record<HomeContent['evaluation']['paths'][number]['id'], string>
}

const { content, links } = Astro.props
---

<section class="home-path-section" id="paths" aria-labelledby="home-paths-title">
  <div class="home-shell">
    <div class="home-path-heading"><div><p class="home-section-index">{content.index}</p><h2 id="home-paths-title">{content.title}</h2></div><p>{content.intro}</p></div>
    <div class="home-path-picker" role="tablist" aria-label="Evaluation paths">
      {content.paths.map((path, index) => (
        <button class:list={['home-path-tab', { 'is-active': index === 0 }]} type="button" role="tab" id={`home-tab-${path.id}`} aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`home-panel-${path.id}`} data-home-path={path.id}>{path.label}</button>
      ))}
    </div>
    {content.paths.map((path, index) => (
      <article class="home-path-panel" id={`home-panel-${path.id}`} role="tabpanel" aria-labelledby={`home-tab-${path.id}`} data-home-panel={path.id} hidden={index !== 0}>
        <span class="home-panel-label">{path.eyebrow}</span><div><h3>{path.title}</h3><p>{path.description}</p></div><a class="home-button home-button-primary" href={links[path.id]}>{path.action} <span>→</span></a>
      </article>
    ))}
  </div>
</section>

<script>
  import '../../scripts/home-evaluation'
</script>
