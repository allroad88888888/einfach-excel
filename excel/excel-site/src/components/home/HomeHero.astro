---
import type { HomeContent } from '../../data/home-content'

interface Props {
  content: HomeContent['hero']
  primaryHref: string
  secondaryHref: string
}

const { content, primaryHref, secondaryHref } = Astro.props
---

<section class="home-hero home-shell" aria-labelledby="home-hero-title">
  <div class="home-hero-copy">
    <p class="home-kicker"><span class="home-live-dot"></span>{content.kicker}</p>
    <h1 id="home-hero-title">{content.titleStart} <em>{content.titleAccent}</em></h1>
    <p class="home-hero-summary">{content.summary}</p>
    <div class="home-hero-actions">
      <a class="home-button home-button-primary" href={primaryHref}>{content.primaryAction} <span aria-hidden="true">→</span></a>
      <a class="home-button home-button-quiet" href={secondaryHref}>{content.secondaryAction}</a>
    </div>
    <p class="home-micro-copy">{content.note}</p>
  </div>
  <div class="home-workbench" aria-label="Revenue plan worksheet preview">
    <div class="home-workbench-topbar">
      <div class="home-file-title"><span class="home-sheet-icon">▦</span><span>Revenue plan <b>.xlsx</b></span></div>
      <div class="home-presence" aria-label="Two collaborators online">
        <span class="home-avatar home-avatar-a">L</span><span class="home-avatar home-avatar-b">M</span><span class="home-share">Share</span>
      </div>
    </div>
    <div class="home-workbench-toolbar">
      <button type="button" aria-label="Undo">↶</button><button type="button" aria-label="Redo">↷</button><span class="home-toolbar-divider"></span>
      <button class="home-toolbar-select" type="button">Inter <span>⌄</span></button><button class="home-toolbar-select" type="button">10 <span>⌄</span></button>
      <button type="button" aria-label="Bold"><strong>B</strong></button><button type="button" aria-label="Text color">A<span class="home-color-line"></span></button>
      <span class="home-toolbar-spacer"></span><button class="home-toolbar-select" type="button">USD <span>⌄</span></button>
    </div>
    <div class="home-formula-bar"><span class="home-cell-reference">E8</span><span class="home-formula-symbol">ƒx</span><code>=SUM(E4:E7)*Assumptions!B20</code></div>
    <div class="home-sheet-grid" role="table" aria-label="Revenue plan">
      <div class="home-grid-corner"></div><div class="home-column-label">A</div><div class="home-column-label">B</div><div class="home-column-label">C</div><div class="home-column-label">D</div><div class="home-column-label">E</div>
      <div class="home-row-label">1</div><div class="home-cell home-header-cell">Channel</div><div class="home-cell home-header-cell">Q1</div><div class="home-cell home-header-cell">Q2</div><div class="home-cell home-header-cell">Q3</div><div class="home-cell home-header-cell">Year</div>
      <div class="home-row-label">2</div><div class="home-cell home-section-cell" style="grid-column: span 5">Revenue plan · FY 2026</div>
      <div class="home-row-label">3</div><div class="home-cell home-muted-cell">Pipeline</div><div class="home-cell home-muted-cell">Actual</div><div class="home-cell home-muted-cell">Forecast</div><div class="home-cell home-muted-cell">Forecast</div><div class="home-cell home-muted-cell">Total</div>
      <div class="home-row-label">4</div><div class="home-cell">Self-serve</div><div class="home-cell home-number-cell">$126k</div><div class="home-cell home-number-cell">$164k</div><div class="home-cell home-number-cell">$198k</div><div class="home-cell home-number-cell">$488k</div>
      <div class="home-row-label">5</div><div class="home-cell">Sales-led</div><div class="home-cell home-number-cell">$214k</div><div class="home-cell home-number-cell">$241k</div><div class="home-cell home-number-cell">$286k</div><div class="home-cell home-number-cell">$741k</div>
      <div class="home-row-label">6</div><div class="home-cell">Partners</div><div class="home-cell home-number-cell">$38k</div><div class="home-cell home-number-cell">$62k</div><div class="home-cell home-number-cell">$91k</div><div class="home-cell home-number-cell">$191k</div>
      <div class="home-row-label">7</div><div class="home-cell">Expansion</div><div class="home-cell home-number-cell">$81k</div><div class="home-cell home-number-cell">$118k</div><div class="home-cell home-number-cell">$139k</div><div class="home-cell home-number-cell">$338k</div>
      <div class="home-row-label home-active-row">8</div><div class="home-cell home-total-cell">Forecast</div><div class="home-cell home-total-cell home-number-cell">$459k</div><div class="home-cell home-total-cell home-number-cell">$585k</div><div class="home-cell home-total-cell home-number-cell">$714k</div><div class="home-cell home-total-cell home-number-cell home-selected-cell">$1.76m<span class="home-fill-handle"></span></div>
    </div>
    <div class="home-sheet-tabs"><button class="home-active-tab" type="button">Plan</button><button type="button">Assumptions</button><button type="button">Pipeline</button><button class="home-add-sheet" type="button" aria-label="Add sheet">＋</button><span>{content.previewStatus}</span></div>
  </div>
</section>
