---
import { homeContent, type HomeContent, type HomeLocale } from '../../data/home-content'
import { homeFrameworkContent, type HomeFrameworkId } from '../../data/home-framework-content'
import { sitePath } from '../../data/site-path'
import '../../styles/home.css'
import '../../styles/home-workbench.css'
import '../../styles/home-proof.css'
import '../../styles/home-evaluation.css'
import '../../styles/home-integration.css'
import '../../styles/home-install.css'
import HomeEvaluation from './HomeEvaluation.astro'
import HomeHero from './HomeHero.astro'
import HomeIntegration from './HomeIntegration.astro'
import HomeInstall from './HomeInstall.astro'
import HomeProof from './HomeProof.astro'

interface Props {
  locale: HomeLocale
}

const { locale } = Astro.props
const content = homeContent[locale]
const localizedPath = (path: string) => sitePath(locale === 'zh' ? `zh/${path}` : path)
const evaluationLinks = Object.fromEntries(
  content.evaluation.paths.map((path) => [path.id, localizedPath(`demos/${path.route}/`)]),
) as Record<HomeContent['evaluation']['paths'][number]['id'], string>
const frameworkLinks: Record<HomeFrameworkId, string> = {
  solid: localizedPath('docs/getting-started/'),
  react: localizedPath('docs/react/'),
  vue: localizedPath('docs/vue/'),
  backend: localizedPath('docs/backend-port/'),
}
const workbenchHref = localizedPath('demos/workbench/')
const guideHref = localizedPath('docs/getting-started/')
const apiHref = localizedPath('api/')
const proofLinks: Record<HomeContent['features'][number]['target'], string> = {
  scale: evaluationLinks.scale,
  formula: evaluationLinks.formula,
  backend: frameworkLinks.backend,
}
---

<main class="home-page">
  <HomeHero content={content.hero} primaryHref={evaluationLinks.formula} secondaryHref={workbenchHref} />
  <HomeProof content={content} links={proofLinks} />
  <HomeEvaluation content={content.evaluation} links={evaluationLinks} />
  <HomeIntegration
    content={content.integration}
    frameworks={homeFrameworkContent[locale]}
    links={frameworkLinks}
  />
  <HomeInstall content={content.install} guideHref={guideHref} apiHref={apiHref} />
</main>
