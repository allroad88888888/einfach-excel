---
import type { HomeContent } from '../../data/home-content'

interface Props {
  content: Pick<HomeContent, 'signals' | 'thesis' | 'features'>
}

const { content } = Astro.props
---

<section class="home-proof">
  <div class="home-signal-strip home-shell" aria-label="Product capabilities">
    {content.signals.map((signal) => (
      <article><span class="home-signal-icon">{signal.icon}</span><div><strong>{signal.title}</strong><p>{signal.description}</p></div></article>
    ))}
  </div>
  <div class="home-feature-section home-shell" id="why" aria-labelledby="home-thesis-title">
    <div class="home-section-intro"><p class="home-section-index">{content.thesis.index}</p><h2 id="home-thesis-title">{content.thesis.title}</h2></div>
    <div class="home-feature-grid">
      {content.features.map((feature, index) => (
        <article class:list={['home-feature-card', { 'home-feature-card-lead': index === 0 }]}>
          <p class="home-card-number">{feature.number}</p><h3>{feature.title}</h3><p>{feature.description}</p><a href={`#${feature.target}`}>{feature.action} <span>→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
