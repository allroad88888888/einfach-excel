---
import '../styles/site.css'
import '../styles/subpage.css'
import '../styles/subpage-content.css'
import { sitePath } from '../data/site-path'

interface Props {
  locale: 'en' | 'zh'
  title: string
  alternateLocaleHref?: string
  variant?: 'default' | 'home'
}

const { locale, title, alternateLocaleHref, variant = 'default' } = Astro.props
const isZh = locale === 'zh'
const isHome = variant === 'home'
const rootHref = sitePath(isZh ? 'zh/' : '')
const demosHref = sitePath(isZh ? 'zh/#demos' : '#demos')
const docsHref = sitePath(isZh ? 'zh/docs/getting-started/' : 'docs/getting-started/')
const apiHref = sitePath(isZh ? 'zh/api/' : 'api/')
const languageHref = alternateLocaleHref ?? sitePath(isZh ? '' : 'zh/')
---

<!doctype html>
<html lang={isZh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Einfach spreadsheet engine demos and integration documentation." />
    <meta property="og:image" content={sitePath('social-preview.png')} />
    <link rel="icon" href={sitePath('favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'site-body-home': isHome, 'site-body-subpage': !isHome }}>
    <header class="site-header">
      <a class="wordmark" href={rootHref}>
        <span class="site-brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>einfach<span class="site-brand-muted">/</span>excel</span>
      </a>
      {
        isHome ? (
          <>
            <nav aria-label={isZh ? '主导航' : 'Primary navigation'}>
              <a href="#why">{isZh ? '为什么是它' : 'Why it works'}</a>
              <a href="#paths">{isZh ? '开始评估' : 'Evaluate'}</a>
              <a href="#integrate">{isZh ? '集成' : 'Integrate'}</a>
              <a href={docsHref}>{isZh ? '文档' : 'Docs'}</a>
              <a href={languageHref}>{isZh ? 'EN' : '中文'}</a>
            </nav>
            <a class="home-header-link" href="https://github.com/allroad88888888/einfach-excel">GitHub ↗</a>
          </>
        ) : (
          <nav aria-label={isZh ? '主导航' : 'Primary navigation'}>
            <a href={demosHref}>{isZh ? '演示' : 'Demos'}</a>
            <a href={docsHref}>{isZh ? '文档' : 'Docs'}</a>
            <a href={apiHref}>API</a>
            <a href={languageHref}>{isZh ? 'EN' : '中文'}</a>
            <button id="theme-toggle" type="button" aria-label={isZh ? '切换颜色主题' : 'Toggle color theme'}>◐</button>
          </nav>
        )
      }
    </header>
    <slot />
    {
      isHome ? (
        <footer class="site-footer" id="docs">
          <div class="home-shell home-footer-inner">
            <a class="wordmark" href={rootHref}>
              <span class="site-brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span>einfach<span class="site-brand-muted">/</span>excel</span>
            </a>
            <p>{isZh ? '面向产品团队的电子表格基础设施。' : 'Spreadsheet infrastructure for product teams.'}</p>
            <div class="home-footer-links">
              <a href={docsHref}>{isZh ? '架构' : 'Architecture'}</a><a href={apiHref}>API</a><a href="https://github.com/allroad88888888/einfach-excel">GitHub ↗</a>
            </div>
          </div>
        </footer>
      ) : (
        <footer class="site-footer">
          <span>einfach · excel</span>
          <a href="https://github.com/allroad88888888/einfach-excel">GitHub</a>
        </footer>
      )
    }
    <script>
      import '../scripts/theme-toggle'
    </script>
  </body>
</html>
