{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsxImportSource": "solid-js"
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": [
    "src/main.tsx",
    "src/routes.tsx",
    "src/landing/**/*",
    "src/shell/**/*",
    "src/workbench/**/*",
    "src/demos/DemoGalleryPage.tsx",
    "src/demos/DemoPage.tsx",
    "src/demos/DemoShell.tsx",
    "src/demos/registry.ts",
    "src/demos/registry-types.ts",
    "src/demos/pages/**/*"
  ]
}
