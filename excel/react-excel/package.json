{
  "name": "@einfach/react-excel",
  "version": "0.0.0",
  "private": true,
  "description": "React adapter package skeleton for Einfach Excel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pointer-selection": {
      "types": "./src/use-spreadsheet-pointer-selection.ts",
      "import": "./src/use-spreadsheet-pointer-selection.ts",
      "default": "./src/use-spreadsheet-pointer-selection.ts"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/spreadsheet-ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "scripts": {
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.0.0"
  }
}
