{
  "name": "@einfach/react-excel",
  "version": "0.0.0",
  "private": true,
  "description": "React workbook product powered by the Einfach Rust/WASM engine",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@einfach/canvas-cells": "workspace:*",
    "@einfach/core": "^0.4.0",
    "@einfach/react": "^0.4.0",
    "@einfach/react-cells": "workspace:*",
    "@einfach/spreadsheet-ui-core": "workspace:*",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui compile --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@lingui/cli": "6.9.1",
    "@lingui/format-po": "6.9.1",
    "@lingui/vite-plugin": "6.9.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^25.0.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
