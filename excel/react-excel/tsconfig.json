{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@einfach-excel/canvas-cells": ["../../packages/canvas-cells/src/index.ts"],
      "@einfach-excel/canvas": ["../../packages/canvas/src/index.ts"],
      "@einfach-excel/react-cells": ["../../packages/react-cells/src/index.ts"],
      "@einfach-excel/spreadsheet-ui-core": ["../spreadsheet-ui-core/src/index.ts"],
      "@einfach-excel/spreadsheet-ui-core/*": ["../spreadsheet-ui-core/src/*"]
    },
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./test/**/*.ts",
    "./test/**/*.tsx",
    "./e2e/**/*.ts",
    "./e2e/**/*.tsx",
    "./playwright.config.ts",
    "./lingui.config.ts",
    "./vite.config.ts",
    "./vitest.config.ts"
  ]
}
