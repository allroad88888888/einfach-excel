{
  "name": "@einfach/solid-excel",
  "version": "0.1.0",
  "description": "SolidJS Excel table component powered by Rust WASM engine",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./vnext": {
      "types": "./src-vnext/public.ts",
      "import": "./src-vnext/public.ts",
      "default": "./src-vnext/public.ts"
    },
    "./vnext-worker-factory": {
      "types": "./src-vnext/adapter/worker-factory.ts",
      "import": "./src-vnext/adapter/worker-factory.ts",
      "default": "./src-vnext/adapter/worker-factory.ts"
    },
    "./vnext-worker-runtime": {
      "types": "./src-vnext/adapter/worker-runtime.ts",
      "import": "./src-vnext/adapter/worker-runtime.ts",
      "default": "./src-vnext/adapter/worker-runtime.ts"
    },
    "./vnext-worker-runtime-full": {
      "types": "./src-vnext/adapter/worker-runtime-full.ts",
      "import": "./src-vnext/adapter/worker-runtime-full.ts",
      "default": "./src-vnext/adapter/worker-runtime-full.ts"
    },
    "./vnext-worker-runtime-core": {
      "types": "./src-vnext/adapter/worker-runtime-core.ts",
      "import": "./src-vnext/adapter/worker-runtime-core.ts",
      "default": "./src-vnext/adapter/worker-runtime-core.ts"
    },
    "./legacy": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./demos": {
      "types": "./src/demos/index.ts",
      "import": "./src/demos/index.ts",
      "default": "./src/demos/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./vnext-styles.css": "./src-vnext/styles/index.css",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allroad88888888/einfach-excel.git",
    "directory": "excel/solid-excel"
  },
  "homepage": "https://github.com/allroad88888888/einfach-excel/tree/main/excel/solid-excel",
  "bugs": {
    "url": "https://github.com/allroad88888888/einfach-excel/issues"
  },
  "files": [
    "src",
    "src-vnext",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "pnpm --filter @einfach/excel-wasm run build:wasm",
    "build:wasm:full": "pnpm --filter @einfach/excel-wasm run build:wasm:full",
    "build:wasm:both": "pnpm --filter @einfach/excel-wasm run build:wasm:both",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "spreadsheet",
    "excel",
    "solid-js",
    "wasm",
    "web-worker",
    "einfach"
  ],
  "dependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/excel-core-ts": "workspace:*",
    "@einfach/excel-wasm": "workspace:*",
    "@einfach/solid": "^0.4.0",
    "@einfach/spreadsheet-ui-core": "workspace:*",
    "@einfach/spreadsheet-ui-styles": "workspace:*",
    "@lingui/core": "^6.0.1",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.48.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.8.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0"
  }
}
