{
  "name": "@einfach/solid-excel",
  "version": "0.1.1",
  "private": true,
  "description": "SolidJS Excel table component powered by Rust WASM engine",
  "type": "module",
  "main": "./esm/src/index.mjs",
  "types": "./@types/src/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./@types/src/index.d.ts",
      "import": "./esm/src/index.mjs",
      "default": "./esm/src/index.mjs"
    },
    "./vnext": {
      "solid": "./src/public.ts",
      "types": "./@types/src/public.d.ts",
      "import": "./esm/src/public.mjs",
      "default": "./esm/src/public.mjs"
    },
    "./worker-factory": {
      "solid": "./src/adapter/worker-factory.ts",
      "types": "./@types/src/adapter/worker-factory.d.ts",
      "import": "./esm/src/adapter/worker-factory.mjs",
      "default": "./esm/src/adapter/worker-factory.mjs"
    },
    "./vnext-worker-factory": {
      "solid": "./src/adapter/worker-factory.ts",
      "types": "./@types/src/adapter/worker-factory.d.ts",
      "import": "./esm/src/adapter/worker-factory.mjs",
      "default": "./esm/src/adapter/worker-factory.mjs"
    },
    "./worker-runtime": {
      "solid": "./src/adapter/worker-runtime.ts",
      "types": "./@types/src/adapter/worker-runtime.d.ts",
      "import": "./esm/src/adapter/worker-runtime.mjs",
      "default": "./esm/src/adapter/worker-runtime.mjs"
    },
    "./vnext-worker-runtime": {
      "solid": "./src/adapter/worker-runtime.ts",
      "types": "./@types/src/adapter/worker-runtime.d.ts",
      "import": "./esm/src/adapter/worker-runtime.mjs",
      "default": "./esm/src/adapter/worker-runtime.mjs"
    },
    "./worker-backend": {
      "solid": "./src/adapter/worker-workbook-backend.ts",
      "types": "./@types/src/adapter/worker-workbook-backend.d.ts",
      "import": "./esm/src/adapter/worker-workbook-backend.mjs",
      "default": "./esm/src/adapter/worker-workbook-backend.mjs"
    },
    "./worker-runtime-full": {
      "solid": "./src/adapter/worker-runtime-full.ts",
      "types": "./@types/src/adapter/worker-runtime-full.d.ts",
      "import": "./esm/src/adapter/worker-runtime-full.mjs",
      "default": "./esm/src/adapter/worker-runtime-full.mjs"
    },
    "./vnext-worker-runtime-full": {
      "solid": "./src/adapter/worker-runtime-full.ts",
      "types": "./@types/src/adapter/worker-runtime-full.d.ts",
      "import": "./esm/src/adapter/worker-runtime-full.mjs",
      "default": "./esm/src/adapter/worker-runtime-full.mjs"
    },
    "./worker-runtime-core": {
      "solid": "./src/adapter/worker-runtime-core.ts",
      "types": "./@types/src/adapter/worker-runtime-core.d.ts",
      "import": "./esm/src/adapter/worker-runtime-core.mjs",
      "default": "./esm/src/adapter/worker-runtime-core.mjs"
    },
    "./vnext-worker-runtime-core": {
      "solid": "./src/adapter/worker-runtime-core.ts",
      "types": "./@types/src/adapter/worker-runtime-core.d.ts",
      "import": "./esm/src/adapter/worker-runtime-core.mjs",
      "default": "./esm/src/adapter/worker-runtime-core.mjs"
    },
    "./legacy": {
      "solid": "./legacy/index.tsx",
      "types": "./@types/legacy/index.d.ts",
      "import": "./esm/legacy/index.mjs",
      "default": "./esm/legacy/index.mjs"
    },
    "./demos": {
      "solid": "./src/demos/index.ts",
      "types": "./@types/src/demos/index.d.ts",
      "import": "./esm/src/demos/index.mjs",
      "default": "./esm/src/demos/index.mjs"
    },
    "./i18n": {
      "solid": "./src/i18n/index.ts",
      "types": "./@types/src/i18n/index.d.ts",
      "import": "./esm/src/i18n/index.mjs",
      "default": "./esm/src/i18n/index.mjs"
    },
    "./styles.css": "./src/styles/index.css",
    "./vnext-styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allroad88888888/einfach-excel.git",
    "directory": "excel/solid-excel"
  },
  "homepage": "https://github.com/allroad88888888/einfach-excel/tree/main/excel/solid-excel",
  "bugs": {
    "url": "https://github.com/allroad88888888/einfach-excel/issues"
  },
  "files": [
    "legacy",
    "src",
    "esm",
    "@types/src",
    "@types/legacy",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:bench": "EINFACH_PERF=1 vitest run",
    "test:watch": "vitest",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "pnpm --filter @einfach/excel-wasm run build:wasm",
    "build:wasm:full": "pnpm --filter @einfach/excel-wasm run build:wasm:full",
    "build:wasm:both": "pnpm --filter @einfach/excel-wasm run build:wasm:both",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "spreadsheet",
    "excel",
    "solid-js",
    "wasm",
    "web-worker",
    "einfach"
  ],
  "dependencies": {
    "@einfach/excel-core-ts": "workspace:*",
    "@einfach/excel-wasm": "workspace:*",
    "@einfach/spreadsheet-ui-core": "workspace:*",
    "@einfach/spreadsheet-ui-styles": "workspace:*",
    "@lingui/core": "^6.0.1"
  },
  "peerDependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/solid": "^0.4.0",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@einfach/core": "^0.4.0",
    "@einfach/solid": "^0.4.0",
    "@playwright/test": "^1.48.0",
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^25.0.1",
    "solid-js": "^1.9.12",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.8.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.1.9"
  }
}
