{
  "name": "@einfach/vue-excel",
  "version": "0.0.1",
  "private": true,
  "description": "Vue adapter package skeleton for Einfach Excel",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./pointer-selection": {
      "types": "./src/use-spreadsheet-pointer-selection.ts",
      "import": "./src/use-spreadsheet-pointer-selection.ts",
      "default": "./src/use-spreadsheet-pointer-selection.ts"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/spreadsheet-ui-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@swc/core": "^1.5.0",
    "@testing-library/jest-dom": "^6.4.5",
    "jsdom": "^25.0.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.41"
  }
}
