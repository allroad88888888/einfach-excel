{
  "name": "einfach-excel",
  "private": true,
  "version": "1.0.0",
  "description": "在线表格栈：React 表格界面 + 框架无关 UI Core + Rust/WASM 工作簿引擎",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/allroad88888888/einfach-excel.git"
  },
  "homepage": "https://github.com/allroad88888888/einfach-excel",
  "bugs": {
    "url": "https://github.com/allroad88888888/einfach-excel/issues"
  },
  "scripts": {
    "eslint": "npx eslint --config rules/.eslintrc --ext=.tsx,.ts --ignore-path ./rules/.eslintignore ./ --fix ",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:presentation": "node scripts/check-presentation-boundary.mjs",
    "check:cycles": "depcruise --config .dependency-cruiser.cjs --output-type err-long excel/excel-core-ts/src excel/spreadsheet-ui-core/src excel/react-excel/src",
    "lint:check": "npx eslint --config rules/.eslintrc --ext=.ts,.tsx --ignore-path ./rules/.eslintignore excel/excel-core-ts/src excel/excel-core-ts/test excel/react-excel/src excel/react-excel/test excel/spreadsheet-ui-core/src excel/spreadsheet-ui-core/test",
    "typecheck:mainline": "tsc -build excel/spreadsheet-ui-core && pnpm --filter @einfach/react-excel typecheck",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:coverage": "vitest run --workspace vitest.workspace.ts --coverage",
    "test:scripts": "node --test scripts/generate-ad509-benchmark-fixtures.test.mjs scripts/generate-ad806-filled-tsv.test.mjs scripts/measure-ad512-size-composition.test.mjs",
    "clearTypes": "node clean.js",
    "ensureWasm": "test -f excel/excel-wasm/lite/einfach_wasm.js || npm run build:wasm -w @einfach/excel-wasm",
    "build": "npm run clearTypes&&npm run ensureWasm&&npm run check:presentation&&tsc -build excel/spreadsheet-ui-core excel/excel-core-ts&&pnpm --filter @einfach/react-excel typecheck&&npx rollup -c ./rollup.config.mjs&&pnpm --filter @einfach/react-excel build",
    "release:publish": "pnpm publish -r --access public --no-git-checks && pnpm changeset tag",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "build:publish": "npm run clearTypes&&npm run ensureWasm&&tsc -build excel/spreadsheet-ui-core excel/excel-core-ts&&npx rollup -c ./rollup.config.mjs",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "dol",
  "license": "MIT",
  "workspaces": [
    "excel/*"
  ],
  "pnpm": {
    "overrides": {
      "solid-js": "1.9.12"
    }
  },
  "dependencies": {
    "@changesets/cli": "^2.27.1",
    "@stylistic/eslint-plugin": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^7.10.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-swc": "^0.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@solidjs/testing-library": "^0.8.10",
    "@swc/core": "^1.5.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.10.4",
    "husky": "^9.0.11",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.27.4",
    "solid-js": "^1.9.12",
    "vitest": "^2.1.9"
  }
}
