{
  "name": "@einfach/canvas-cells",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canvas spreadsheet cells with owned atom subscriptions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@einfach/canvas": "workspace:*",
    "@einfach/core": "^0.4.0",
    "@einfach/spreadsheet-ui-core": "workspace:*"
  },
  "devDependencies": {
    "@einfach/canvas": "workspace:*",
    "@einfach/core": "^0.4.0",
    "@einfach/spreadsheet-ui-core": "workspace:*",
    "@types/node": "^22.19.0",
    "typescript": "^5.7.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
