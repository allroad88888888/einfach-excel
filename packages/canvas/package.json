{
  "name": "@einfach-excel/canvas",
  "version": "0.1.0",
  "description": "Canvas cells with owned atom subscriptions and region caches",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@einfach/core": "^0.4.0"
  },
  "devDependencies": {
    "@einfach/core": "^0.4.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.5",
    "vite": "8.3.4"
  }
}
