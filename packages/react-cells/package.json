{
  "name": "@einfach-excel/react-cells",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React spreadsheet cell rendering backed by UI Core atoms",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/react": "^0.4.0",
    "@einfach-excel/spreadsheet-ui-core": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/react": "^0.4.0",
    "@einfach-excel/spreadsheet-ui-core": "workspace:*",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
