{
  "name": "@einfach-excel/plugin-chart",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Optional ECharts charts anchored on worksheet cells",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.tsx",
    "./core": "./src/core/index.ts",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/echarts-runtime.ts",
    "./dist/echarts-runtime*.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allroad88888888/einfach-excel.git",
    "directory": "plugins/plugin-chart"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node ../build-plugins.mjs .",
    "verify:package-artifact": "node ../verify-plugins.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@einfach/core": "^0.4.0",
    "@einfach/react": "^0.4.0",
    "@einfach-excel/react-excel": ">=0.1.0 <1.0.0",
    "@einfach-excel/spreadsheet-ui-core": ">=0.2.0 <1.0.0",
    "@lingui/core": "^6.9.1",
    "@lingui/react": "^6.9.1",
    "echarts": "^6.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@einfach-excel/react-excel": "workspace:*",
    "@einfach-excel/spreadsheet-ui-core": "workspace:*",
    "@einfach/core": "^0.4.0",
    "@einfach/react": "^0.4.0",
    "@lingui/core": "6.9.1",
    "@lingui/react": "6.9.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "6.1.2",
    "echarts": "6.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "5.0.5"
  }
}
